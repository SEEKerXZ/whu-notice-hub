# 复制为 .env 后修改（.env 不会进仓库）
TZ=Asia/Shanghai
DB_PATH=/app/data/app.db
LOG_LEVEL=INFO

# 受众过滤：undergrad = 只要本科生相关通知（留空则不过滤）
AUDIENCE=undergrad

# 网页认证（留空则不启用；建议配合 SSH 隧道访问，不要把端口暴露公网）
WEB_USER=
WEB_PASSWORD=
# 邮件里回链的站点地址（留空则不显示链接）
SITE_URL=

# 抓取模式：0 = 只抓列表页（站点只展示标题与概览，正文走原文链接，最安全）
#          1 = 额外抓详情页（可生成摘要/截止日期，但请求量增加，可能触发站点验证码）
DETAIL_ENABLED=0

# 内置定时抓取
SCHEDULER_ENABLED=1
CRAWL_INTERVAL_MINUTES=60

# 抓取限速（防 WAF 限流：默认每 host 4 秒 1 次 + 随机抖动）
FETCH_MIN_INTERVAL=4.0
# 命中验证码后熔断该站点多久（秒）
WAF_COOLDOWN_SECONDS=1800
# 单轮抓取的最大请求数
MAX_REQUESTS_PER_RUN=40

# 邮件推送（多数邮箱服务商需使用「授权码」而不是登录密码）
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=
MAIL_TO=your-email@example.com

# 企业微信群机器人（群设置 → 群机器人 → 添加 → 复制 Webhook 地址）
WECOM_WEBHOOK=

# QQ 官方机器人（QQ 开放平台 → 机器人 → 开发设置）
# 注意：QQ 官方群机器人不支持主动推送，只能被动回复（群里 @机器人 发「日报」）
QQ_APPID=
QQ_APPSECRET=

# AI 问答（OpenAI 兼容接口，默认 DeepSeek）；不填则机器人只回固定指令
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat

# 闲聊模式：1 = @机器人 时如果没有匹配的通知，就用 AI 简短闲聊；0 = 只回答通知
AI_CHAT_MODE=1

# 人设：catgirl = 猫娘 L2（默认）；default = 正常人设
PERSONA=catgirl
# 强度：1 轻量 / 2 标准 / 3 浓郁（当前实现按 2 设计）
PERSONA_LEVEL=2

# AI 问答限额（防止被刷、控制成本）
AI_DAILY_LIMIT_PER_USER=8
AI_DAILY_LIMIT_PER_GROUP=150
AI_DAILY_LIMIT_TOTAL=300
AI_MIN_INTERVAL_SECONDS=5

# 重要度阈值：达到才即时推送（按当前打分分布，65 能覆盖推免/考试/奖学金类）
PUSH_MIN_IMPORTANCE=65

# 日报发送时间（每天）
DIGEST_HOUR=8
DIGEST_MINUTE=30

# 快照保留天数
SNAPSHOT_KEEP_DAYS=7

# 可选：抓取时通过 From 头表明联系邮箱
CONTACT_EMAIL=
