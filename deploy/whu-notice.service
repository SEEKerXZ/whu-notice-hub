[Unit]
Description=WHU Notice Hub (crawler + web)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/whu-notice-hub
EnvironmentFile=/opt/whu-notice-hub/.env
ExecStart=/opt/whu-notice-hub/.venv/bin/uvicorn app.web:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
